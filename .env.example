# ─── Apex-MEV UltraSafe v12 — Environment Configuration ─────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
# Use a private/dedicated RPC for low-latency pre-simulation.
# Public endpoints are rate-limited and unsuitable for production MEV.
RPC_URL_PRIVATE=https://your-private-rpc.example.com

# WebSocket endpoint for real-time account/slot notifications.
WS_URL_PRIVATE=wss://your-private-rpc.example.com

# ─── Keypair ──────────────────────────────────────────────────────────────────
# Base58-encoded 64-byte keypair (output of `solana-keygen new --outfile key.json`).
# NEVER share or commit this value.
PRIVATE_KEY=INSERT_BASE58_PRIVATE_KEY_HERE

# ─── Execution Controls ───────────────────────────────────────────────────────
# Set to true to submit real transactions. Start with false (paper trade mode).
EXECUTE_TRADES=false

# Dry-run: simulate everything but never submit. Overrides EXECUTE_TRADES.
DRY_RUN=true

# Maximum number of trades per 60-second window (rate limit).
MAX_TRADES_PER_MINUTE=10

# ─── Profitability ────────────────────────────────────────────────────────────
# Minimum net profit (after fees) required to execute a trade (in lamports).
# 1 SOL = 1,000,000,000 lamports. Start conservative.
MIN_PROFIT_LAMPORTS=10000

# Maximum single-trade position size in lamports.
MAX_POSITION_SIZE=200000000

# Slippage tolerance in basis points (50 = 0.5%).
SLIPPAGE_BPS=50

# ─── Fees ─────────────────────────────────────────────────────────────────────
# Priority fee per compute unit in micro-lamports.
PRIORITY_FEE_LAMPORTS=5000

# ─── Jito Bundle Submission ───────────────────────────────────────────────────
# Enable Jito bundle submission for MEV protection and atomic execution.
USE_JITO=false

# Jito tip in lamports added to bundles (adaptive strategy will adjust this).
JITO_TIP_LAMPORTS=10000

# ─── Safety ───────────────────────────────────────────────────────────────────
# Number of consecutive losses before circuit breaker trips.
CIRCUIT_BREAKER_THRESHOLD=5

# Maximum fraction of wallet balance to use as collateral for flash loans.
MAX_BORROW_RATIO=0.8

# ─── Path Finding ─────────────────────────────────────────────────────────────
# Maximum hops in a single arbitrage path (1-6).
MAX_HOPS=6

# Maximum number of candidate paths to evaluate per strategy tick.
MAX_CANDIDATE_PATHS=512

# Maximum pool staleness in slots (32 slots ≈ 12 seconds).
MAX_POOL_AGE_SLOTS=32

# ─── Observability ────────────────────────────────────────────────────────────
LOG_METRICS=true
HOT_RELOAD_CONFIG=true
PERFORMANCE_MONITORING=true

# Prometheus metrics server port.
METRICS_PORT=9090

# ─── Logging ──────────────────────────────────────────────────────────────────
# RUST_LOG controls tracing output.
# Use `apex_mev=debug,info` for verbose debug; `info` for production.
RUST_LOG=info
